[Unit]
Description=Bybit Earn yield rotation — Telegram operator commands (/unwind, /resume)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hermes
Group=hermes
WorkingDirectory=/opt/hermes/yield_rotation
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ExecStart=/opt/hermes/venvs/yield_rotation/bin/python /opt/hermes/yield_rotation/telegram_bot.py
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
