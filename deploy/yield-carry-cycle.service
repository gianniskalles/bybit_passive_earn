[Unit]
Description=Funding carry — one cycle (no LLM)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hermes
Group=hermes
WorkingDirectory=/opt/hermes/yield_rotation
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ExecStart=/opt/hermes/venvs/yield_rotation/bin/python /opt/hermes/yield_rotation/run_carry_cycle.py
# One cycle must finish inside the 5-minute cadence (flock skips an overlap).
TimeoutStartSec=280
