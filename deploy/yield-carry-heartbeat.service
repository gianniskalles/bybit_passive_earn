[Unit]
Description=Funding carry — carry risk state heartbeat
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hermes
Group=hermes
WorkingDirectory=/opt/hermes/yield_rotation
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ExecStart=/opt/hermes/venvs/yield_rotation/bin/python /opt/hermes/yield_rotation/heartbeat.py --system carry
TimeoutStartSec=120
